{
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://campusprint-3agy.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://campusprint-3agy.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
