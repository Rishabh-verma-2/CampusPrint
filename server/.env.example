# =============================================================================
# CampusPrint Server Environment Configuration
# =============================================================================

PORT=5001
NODE_ENV=development

# MongoDB Connection String (Paste your URI here)
MONGO_URI=

# JWT Secrets
JWT_SECRET=campusprint_super_secret_jwt_key_2025_dev
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=campusprint_super_secret_refresh_key_2025_dev
JWT_REFRESH_EXPIRES_IN=30d

# Client Web App URL (CORS)
CLIENT_URL=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# Local File Uploads Directory
UPLOADS_DIR=uploads

# Cloudinary (Optional - leave blank to use local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cashfree Payment Gateway
# CASHFREE_ENV: "sandbox" for testing, "production" for live
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01

# Public URLs (used to build Cashfree return_url and notify_url)
# In production: set to your actual deployed URLs
FRONTEND_URL=https://campusprint.vercel.app
BACKEND_URL=https://campusprint-3agy.onrender.com

# Resend Email (Optional)
RESEND_API_KEY=
